<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EasyGit.WinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel Spacing="14" Padding="16">
            <TextBlock Text="EasyGit Options" FontSize="20" FontWeight="SemiBold" />

            <TextBlock Text="Git auto sync interval (minutes)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <NumberBox Width="220" Minimum="1" Value="{Binding GitAutoSyncIntervalMinutes, Mode=TwoWay}" />

            <TextBlock Text="Protected branches (comma-separated)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBox Width="560" Text="{Binding ProtectedBranches, Mode=TwoWay}" />

            <TextBlock Text="Azure DevOps Organization URL" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBox Width="560" Text="{Binding AzureDevOpsOrganizationUrl, Mode=TwoWay}" />

            <TextBlock Text="Azure DevOps PAT" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <PasswordBox x:Name="AzureDevOpsPatBox" Width="560" PasswordChanged="AzureDevOpsPatBox_PasswordChanged" />

            <TextBlock Text="Azure OpenAI Endpoint" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBox Width="560" Text="{Binding AzureOpenAiEndpoint, Mode=TwoWay}" />

            <TextBlock Text="Azure OpenAI Deployment" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBox Width="560" Text="{Binding AzureOpenAiDeployment, Mode=TwoWay}" />

            <TextBlock Text="Azure OpenAI API Key" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <PasswordBox x:Name="AzureOpenAiApiKeyBox" Width="560" PasswordChanged="AzureOpenAiApiKeyBox_PasswordChanged" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

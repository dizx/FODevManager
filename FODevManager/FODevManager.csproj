<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	<AssemblyName>fodev</AssemblyName>
	<RootNamespace>FODevManager</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
	<AssemblyVersion>1.2.1</AssemblyVersion>
	<FileVersion>1.2.1</FileVersion>
	<Version>1.2.1</Version>
	<InformationalVersion>1.2.1</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
	<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoDevManager.Shared\FODevManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'$(PublishAsWinUICompanion)' == 'true'">Never</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateCompanionPublish" BeforeTargets="PrepareForPublish" Condition="'$(PublishAsWinUICompanion)' == 'true'">
    <Error Condition="'$(PublishTrimmed)' == 'true'" Text="Combined WinUI/CLI publishing requires PublishTrimmed=false" />
    <Error Condition="'$(PublishSingleFile)' == 'true'" Text="Combined WinUI/CLI publishing requires PublishSingleFile=false" />
    <Error Condition="'$(UseAppHost)' != 'true'" Text="Combined WinUI/CLI publishing requires UseAppHost=true" />
  </Target>

  <Target Name="RemovePublishedDevelopmentConfiguration" AfterTargets="Publish">
    <Delete Files="$([System.IO.Path]::Combine('$(PublishDir)', 'appsettings.Development.json'))" />
  </Target>
</Project>


<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FODevManager.WinUI.BusyOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FODevManager.WinUI"
    xmlns:conv="using:FODevManager.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#80000000"
        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
        IsHitTestVisible="True"
        IsTabStop="True"
        TabFocusNavigation="Cycle"
        PointerPressed="OverlayRoot_PointerPressed"
        PointerReleased="OverlayRoot_PointerReleased"
        Tapped="OverlayRoot_Tapped"
        DoubleTapped="OverlayRoot_DoubleTapped"
        RightTapped="OverlayRoot_RightTapped"
        Holding="OverlayRoot_Holding"
        KeyDown="OverlayRoot_KeyDown">

        <Border x:Name="FocusSink" Width="0" Height="0" Background="Transparent" />


        <Grid Width="700" MaxHeight="480" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24"/>
                    <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold"/>
                </StackPanel>
                <Border Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="340">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock Text="This will close when the operation completes." Opacity="0.7" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<Window
    x:Class="FODevManager.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FODevManager.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:FODevManager.WinUI.Converters" xmlns:vm="using:FODevManager.WinUI.ViewModel"
    mc:Ignorable="d"  Title="FO Dev Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Border Background="{ThemeResource SystemBaseLowColor}">
        <Grid>

            <Grid.Resources>
                <converters:MessageTypeToColorConverter x:Key="MessageTypeToColorConverter" />
                <converters:BoolToChevronConverter x:Key="BoolToChevronConverter"/>
                <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
                <converters:ModelTypeToBrushConverter x:Key="ModelTypeToBrushConverter" SourceBrush="{ThemeResource TextFillColorPrimaryBrush}" CompiledBrush="CornflowerBlue"/>
                <converters:RepoBranchHealthToBrushConverter x:Key="RepoBranchHealthToBrushConverter" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <!-- Title Bar -->
                <RowDefinition Height="*"/>
                <!-- Content -->
                <RowDefinition Height="Auto"/>
                <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 🔷 Custom Title Bar -->
            <Grid x:Name="AppTitleBar" Grid.Row="0"
                  Background="Transparent"
                  BorderBrush="{ThemeResource SystemBaseLowColor}"
                  BorderThickness="0,0,0,1"
                  Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="18" />
                    <TextBlock Text="FO Dev Manager" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <!-- 🔶 Main Content -->
            <Grid Grid.Row="1" Padding="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Row 0: Profile Selection & Open Solution -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: DB name & Is Active -->
                    <RowDefinition Height="*"/>
                    <!-- Row 2: Models List fills remaining height -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Add Model -->
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 🔷 Row 0: Profile Selection + Open Solution -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="ProfilesDropdown" Width="300" SelectionChanged="ProfilesDropdown_SelectionChanged" ToolTipService.ToolTip="Select an existing profile" />

                    <Button Click="CreateProfile_Click" ToolTipService.ToolTip="Create a new profile">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="14" />
                            <TextBlock Text="Create" />
                        </StackPanel>
                    </Button>

                    <Button ToolTipService.ToolTip="Import a profile from GIT repo or a JSON file">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;" FontSize="14" />
                            <TextBlock Text="Import" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="From File" Click="ImportFromFile_Click"/>
                                <MenuFlyoutItem Text="From Repo" Click="ImportFromRepo_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Click="DeployProfile_Click" ToolTipService.ToolTip="Deploy all undeployed models">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE899;" FontSize="14" />
                            <TextBlock Text="Deploy" />
                        </StackPanel>
                    </Button>

                    <Button Click="UnDeployProfile_Click" ToolTipService.ToolTip="Remove all deployed models">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="14" />
                            <TextBlock Text="UnDeploy" />
                        </StackPanel>
                    </Button>

                    <Button Click="SwitchProfile_Click" ToolTipService.ToolTip="Switch to this profile and redeploy">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8AB;" FontSize="14" />
                            <TextBlock Text="Switch" />
                        </StackPanel>
                    </Button>
                    <Button Click="RefreshProfile_Click" ToolTipService.ToolTip="Refreshes all the information about model deployment etc">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh Profile" />
                        </StackPanel>
                    </Button>

                    <Button ToolTipService.ToolTip="Git actions for all repos in the selected profile">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;" FontSize="14" />
                            <TextBlock Text="Git Actions" />
                        </StackPanel>

                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Reset to Main" Click="GitActions_ResetToMain_Click" />
                                <MenuFlyoutItem Text="Tag Release" Click="GitActions_TagRelease_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Click="DeleteProfile_Click" ToolTipService.ToolTip="Delete the selected profile (removes the profile file)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" />
                            <!-- Delete icon -->
                            <TextBlock Text="Delete Profile" />
                        </StackPanel>
                    </Button>

                </StackPanel>

                <Button Grid.Row="0" Grid.Column="1" Click="OpenSolution_Click" Margin="10,0,0,0" ToolTipService.ToolTip="Open the Visual Studio solution associated with this profile">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="Open Solution" />
                    </StackPanel>
                </Button>

                <!-- 🔷 Row 1: Database Name & Is Active -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,10">
                    <TextBlock Text="Database:" VerticalAlignment="Center" />
                    <TextBox x:Name="DatabaseNameTextBox"
                             Width="200"
                             PlaceholderText="Database name"
                             IsReadOnly="True"
                             KeyDown="DatabaseNameTextBox_KeyDown"
                             ToolTipService.ToolTip="Profile database name. Click Edit to change it." />
                    <Button x:Name="DatabaseNameEditButton"
                            Content="Edit"
                            Click="DatabaseNameEditButton_Click"
                            ToolTipService.ToolTip="Edit the database name for the selected profile" />
                    <Button x:Name="DatabaseNameApplyButton"
                            Content="Apply"
                            Click="DatabaseNameApplyButton_Click"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Apply the database change" />
                    <Button x:Name="DatabaseNameCancelButton"
                            Content="Cancel"
                            Click="DatabaseNameCancelButton_Click"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Cancel editing the database name" />
                    <TextBlock x:Name="DatabaseNameHintText"
                               Text="Local override only. Press Enter or Apply to save, Esc or Cancel to discard."
                               VerticalAlignment="Center"
                               Opacity="0.75"
                               Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Profile Is Active" VerticalAlignment="Center" />
                        <CheckBox x:Name="IsActiveCheckBox" IsEnabled="False" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- 🔷 Row 2: Repo and Models List -->

                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.Resources>
                        <!-- Selector -->
                        <local:CombinedTemplateSelector x:Key="CombinedSelector"
                                        RepoTemplate="{StaticResource RepoItemTemplate}"
                                        NonGitTemplate="{StaticResource NonGitRowTemplate}" />

                        <DataTemplate x:Key="RepoItemTemplate" x:DataType="vm:RepoGroupViewModel">
                            <StackPanel Spacing="8" Margin="0,2,0,2">

                                <!-- Header (double-click to toggle) -->
                                <Grid Margin="0,4,0,2" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" DoubleTapped="RepoHeader_DoubleTapped" Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="16"/>
                                        <!-- NEW: status light -->
                                        <ColumnDefinition Width="240"/>
                                        <!-- branch + badge -->
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Text="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                    <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding BranchHealth, Converter={StaticResource RepoBranchHealthToBrushConverter}}" />

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"> 
                                        <TextBlock Text="{x:Bind Branch, Mode=OneWay}" FontStyle="Italic" VerticalAlignment="Center"/> 
                                        <Border Visibility="{Binding HasMainUpdates, Converter={StaticResource BoolToVisibilityConverter}}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center" Opacity="0.85"> 
                                            <TextBlock Text="main updated" FontSize="12" Opacity="0.9"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="4" Content="Assign Task" Click="AssignTask_ForRepo_Click" Margin="6,0,0,0"/>
                                    <Button Grid.Column="5" Content="Open Task" Click="OpenTask_ForRepo_Click" IsEnabled="{x:Bind HasTask}" Margin="6,0,0,0"/>
                                    <Button Grid.Column="6" Content="DevOps" Click="OpenGitForRepo_Click" Margin="20,0,0,0"/>
                                    <Button x:Name="GridMergeButton" Grid.Column="7" ToolTipService.ToolTip="Merge main into current branch" Click="RepoHeader_GitMerge_Click" x:Load="{x:Bind HasMainUpdates, Mode=OneWay}" 
                                             Margin="8,0,0,0" Padding="12,6" FontWeight="SemiBold">


                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8B5;" FontFamily="Segoe MDL2 Assets" />
                                                <TextBlock Text="Git Merge" />
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <!-- Models (collapse with computed Visibility) -->
                                <ItemsControl ItemsSource="{x:Bind Models, Mode=OneWay}" Visibility="{x:Bind IsExpandedVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProfileEnvironmentViewModel">
                                            <Grid Margin="10,4,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!--<FontIcon Grid.Column="0" Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{x:Bind Model.IsMainFOModel, Converter={StaticResource BoolToVisibilityConverter}}"/>-->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                    <Border x:Name="BorderIsMain" Grid.Column="0" Width="3" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Stretch" Margin="0,2,8,2" x:Load="{x:Bind Model.IsMainFOModel, Mode=OneWay}" />
                                                    <!-- Source -->
                                                    <TextBlock x:Name="ModelNameSource" Text="{x:Bind DisplayNameWithVersion}" Opacity="0.88" x:Load="{x:Bind IsSource, Mode=OneWay}" />
                                                    <!-- Compiled -->
                                                    <TextBlock x:Name="ModelNameCompiled" Text="{x:Bind DisplayNameWithVersion}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="0.8" FontWeight="SemiBold" x:Load="{x:Bind IsCompiled, Mode=OneWay}" />
                                                </StackPanel>


                                                <!-- Source (default color) --><!--
                                                <TextBlock x:Name="ModelNameSource" Grid.Column="0" Text="{x:Bind ModelName}" VerticalAlignment="Center" x:Load="{x:Bind IsSource, Mode=OneWay}" /> 
                                                --><!-- Compiled (accent/blue) --><!--
                                                <TextBlock x:Name="ModelNameCompiled" Grid.Column="0" Text="{x:Bind ModelName}" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" x:Load="{x:Bind IsCompiled, Mode=OneWay}" />-->


                                                <TextBlock Grid.Column="1" Text="{Binding IsDeployed, Converter={StaticResource BoolToStatusConverter}}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="Deploy" Tag="{x:Bind ModelName}" Click="DeployModel_Click" Margin="6,0,0,0"/>
                                                <Button Grid.Column="3" Content="Undeploy" Tag="{x:Bind ModelName}" Click="UnDeployModel_Click" Margin="6,0,0,0"/>
                                                <Button Grid.Column="5" Content="Remove" Tag="{x:Bind ModelName}" Click="RemoveModel_Click" Margin="10,0,0,0" HorizontalAlignment="Right"/>
                                                
                                                
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </DataTemplate>



                        <DataTemplate x:Key="NonGitRowTemplate" x:DataType="vm:ProfileEnvironmentViewModel">
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind DisplayNameWithVersion}" Opacity="0.88" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                    Text="{Binding IsDeployed, Converter={StaticResource BoolToStatusConverter}}"
                                    VerticalAlignment="Center"/>             

                                <Button Grid.Column="2" Content="Deploy" Tag="{x:Bind ModelName}" Click="DeployModel_Click" Margin="6,0,0,0"/>
                                <Button Grid.Column="3" Content="Undeploy" Tag="{x:Bind ModelName}" Click="UnDeployModel_Click" Margin="6,0,0,0"/>

                                <Button Grid.Column="5" Content="Remove"
                                    Tag="{x:Bind ModelName}"
                                    Click="RemoveModel_Click"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Right"/>           
                            </Grid>
                        </DataTemplate>


                    </Grid.Resources>

                    <ListView x:Name="CombinedList" ItemTemplateSelector="{StaticResource CombinedSelector}"  RightTapped="CombinedList_RightTapped" SelectionMode="None" Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Top"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="6"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>



                <!-- 🔷 Row 3: Add Model -->
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <TextBox x:Name="ModelPathTextBox" Width="300" PlaceholderText="Browse model folder or paste NuGet URL..." IsReadOnly="True" />
                    <Button Content="Paste" Click="PasteModelPath_Click" ToolTipService.ToolTip="Paste a model folder path or NuGet URL from the clipboard" />
                    <Button Content="Browse" Click="BrowseModel_Click" ToolTipService.ToolTip="Browse for existing models on disk" />
                    <Button Content="Add Model" Click="AddModel_Click" ToolTipService.ToolTip="Add a model from a local path or a NuGet URL"  />
                    <Button Content="+ Create" Click="CreateModel_Click" ToolTipService.ToolTip="Create a new model from scratch in the selected profile" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Background="{ThemeResource SystemBaseLowColor}" Padding="10" Height="170">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 🧾 Log Area -->
                <ListView x:Name="LogPreviewList"
                    Grid.Column="0" Margin="0,0,10,0" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- kill extra space -->
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Padding" Value="1"/>
                            <Setter Property="Margin" Value="1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>

                        </Style>
                    </ListView.ItemContainerStyle>

                    <!-- keep the item content tight too -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12" Margin="1" Foreground="{Binding Type, Converter={StaticResource MessageTypeToColorConverter}}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>


                </ListView>
                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="8" VerticalAlignment="Bottom">
                    <Button x:Name="SettingsButton" Click="OpenSettings_Click" ToolTipService.ToolTip="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>

                    <Button Width="{Binding ElementName=SettingsButton, Path=ActualWidth}" Click="ShowAboutDialog_Click" ToolTipService.ToolTip="About this app">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="14"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Frame x:Name="RootFrame"/>
            <local:BusyOverlay Grid.RowSpan="3" 
                DataContext="{x:Bind BusyOverlayVm, Mode=OneWay}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
    </Border>
</Window>
